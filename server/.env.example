# Copy to .env for local development. In production these live in
# /etc/chatapp/chatapp.env (see deploy/README.md).
HOST=127.0.0.1
PORT=8787
# Exact origin(s) of the web client, comma separated. No wildcards.
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 only when running behind nginx on the same machine.
TRUST_PROXY=0
