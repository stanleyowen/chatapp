# ~/server/quietroom/.env on the server – chmod 600. Never commit the real one.

# Exact origin(s) of the web client, comma separated, no trailing slash.
ALLOWED_ORIGINS=https://chatapp-clone.netlify.app

# Cloudflare Tunnel token (`cloudflared tunnel token chatapp-api`).
TUNNEL_TOKEN=

# Optional limits
# MAX_CONNECTIONS=5000
# MAX_CONNECTIONS_PER_IP=20
# MAX_ROOMS=10000
